{
  "version": 1,
  "rules": [
    {
      "pattern": "internal/domain/**",
      "disallowed": ["internal/handler/**", "internal/infrastructure/**", "internal/repository/**", "internal/usecase/**", "cmd/**", "ent/**"],
      "message": "Domain layer should not depend on any other layer.",
      "severity": "error"
    },
    {
      "pattern": "internal/usecase/**",
      "disallowed": ["internal/handler/**", "internal/infrastructure/**", "internal/repository/**", "cmd/**"],
      "message": "Use case layer should only depend on domain layer.",
      "severity": "error"
    },
    {
      "pattern": "internal/repository/**",
      "disallowed": ["internal/handler/**", "cmd/**"],
      "message": "Repository layer should only depend on domain and infrastructure layers.",
      "severity": "error"
    },
    {
      "pattern": "internal/handler/**",
      "disallowed": ["cmd/**"],
      "message": "Handler layer should only depend on domain and use case layers.",
      "severity": "error"
    },
    {
      "pattern": "internal/infrastructure/**",
      "disallowed": ["internal/handler/**", "internal/usecase/**", "cmd/**"],
      "message": "Infrastructure layer should only depend on domain layer.",
      "severity": "error"
    },
    {
      "pattern": "**",
      "disallowed": ["fmt.Print*", "log.*"],
      "message": "Use structured logging instead of fmt.Print* or log.*",
      "severity": "warning"
    },
    {
      "pattern": "**/*_test.go",
      "allowed": ["testing", "github.com/stretchr/testify/**"],
      "message": "Use standard testing package or testify for tests",
      "severity": "info"
    },
    {
      "pattern": "internal/**",
      "disallowed": ["os.Exit", "panic("],
      "message": "Avoid using os.Exit or panic in application code",
      "severity": "warning"
    },
    {
      "pattern": "**/*_test.go",
      "message": "Use table-driven tests for comprehensive test coverage",
      "severity": "info"
    }
  ]
}